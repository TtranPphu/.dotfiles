# API keys for provider modules
# Fill in your keys and source this file from your shell config.
# This file is symlinked to zsh/.config/keys.zsh for auto-sourcing.
#
# To avoid committing real keys, create ~/.config/keys.local.zsh
# with the same export statements — it's sourced after this file
# and will override these placeholder values.

