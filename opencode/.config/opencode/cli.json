{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "everforest"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "grouping": "auto"
  },
  "animations": false,
  "mouse": false,
  "tabs": {
    "indicators": "numbers",
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "off"
  },
  "prompt": {
    "paste": "full"
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "terminal": {
    "title": false,
    "copy": "manual"
  }
}
