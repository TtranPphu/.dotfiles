{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "everforest",
    "mode": "system"
  },
  "diffs": {
    "wrap": "none",
    "view": "auto",
    "single": false,
    "tree": true
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "animations": false,
  "mouse": false,
  "tabs": {
    "indicators": "numbers",
    "layout": "vertical",
    "scope": "cwd",
    "mode": "off"
  },
  "prompt": {
    "paste": "compact",
    "editor": true
  },
  "attention": {
    "notifications": true,
    "sound": false,
    "volume": 0.6
  },
  "terminal": {
    "title": false,
    "copy": "manual"
  },
  "keybinds": {
    "app.exit": [
      "ctrl+d",
      "<leader>q"
    ]
  }
}
