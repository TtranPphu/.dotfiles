#!/bin/bash

# Rescue hotkey: enable every display, even when the screen is blank.
# Clears Omarchy's disable flags, re-enables any output Hyprland still reports
# as disabled, then reloads so monitors.lua's scales/positions and the
# remembered column width are reapplied. Idempotent; notifies only when it
# actually restored something. Bound to SUPER + CTRL + DELETE.

set -uo pipefail

restored=false

# Wake the panels first; the hotkey has to work with the screen blanked and no
# UI reachable.
hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true

# Clear the flags that keep outputs off (internal panel disable + mirror).
for toggle in internal-monitor-disable internal-monitor-mirror; do
  if omarchy-hyprland-toggle-enabled "$toggle"; then
    omarchy-hyprland-toggle "$toggle" off
    restored=true
  fi
done

# Re-enable every output still disabled at runtime.
while IFS= read -r name; do
  [[ -n $name ]] || continue
  hyprctl eval "hl.monitor({ output = \"$name\", disabled = false })" >/dev/null 2>&1 || true
  restored=true
done < <(hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.disabled == true) | .name')

# Reapply monitors.lua (scale/position) and the persisted column width.
hyprctl reload >/dev/null 2>&1 || true

if [[ $restored == true ]]; then
  omarchy-notification-send -g 󰍹 "All displays enabled"
fi
