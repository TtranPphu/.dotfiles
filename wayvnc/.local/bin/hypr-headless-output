#!/usr/bin/env bash
# Ensure an enabled Hyprland headless output exists, set its mode/scale, and
# print its name. Used by wayvnc-headless so remote access does not depend on
# the physical monitor staying connected.
set -u

runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
sig=$(ls "$runtime/hypr" 2>/dev/null | head -1)
[ -n "$sig" ] || exit 1
export HYPRLAND_INSTANCE_SIGNATURE="$sig"

# Only reuse an enabled headless output. A disabled one cannot be re-enabled
# reliably by hl.monitor on this Hyprland build, so create a fresh output
# instead of serving a dead monitor.
name=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.name | startswith("HEADLESS-"))][0].name // empty')

if [ -z "$name" ]; then
  hyprctl output create headless >/dev/null 2>&1 || exit 1
  for _ in $(seq 1 20); do
    name=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.name | startswith("HEADLESS-"))][0].name // empty')
    [ -n "$name" ] && break
    sleep 0.1
  done
fi
[ -n "$name" ] || exit 1

hyprctl eval "hl.monitor({ output = \"$name\", disabled = false, mode = \"640x480@60\", position = \"auto\", scale = 1 })" >/dev/null 2>&1

# Wait for the output to be enabled before handing its name to wayvnc.
for _ in $(seq 1 20); do
  hyprctl monitors -j 2>/dev/null | jq -e --arg n "$name" 'any(.[]; .name == $n)' >/dev/null && break
  sleep 0.1
done

printf '%s\n' "$name"
